# Browser-safe Supabase config.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:5173

# Supabase CLI / server helpers. Keep real values only in .env.local or managed secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Worker secrets and model settings. Never expose these through VITE_* variables.
SUPABASE_SECRET_KEY=your_supabase_secret_key
WORKER_SECRET=generate_a_long_random_value_for_scheduled_runs
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_ASSISTANT_MODEL=nvidia/nemotron-3-nano-30b-a3b

# VIOLET AI — Multi-Model Intelligence Gateway Providers
# Backend environment variables. NEVER expose API keys through VITE_* variables.
# Zero API keys configured works cleanly with local Ollama!

# 1. Ollama (Local inference, 0 data egress)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 2. OpenRouter (Multi-model aggregator catalog)
OPENROUTER_API_KEY=your_openrouter_api_key

# 3. OpenAI (Official chat completions & tool use)
OPENAI_API_KEY=your_openai_api_key
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# 4. Google Gemini (Multimodal & streaming generation)
GEMINI_API_KEY=your_gemini_api_key

# 5. Anthropic Claude (Flagship reasoning & tool use)
ANTHROPIC_API_KEY=your_anthropic_api_key

# 6. VIOLET AI — Phase 3G Single-Owner Identity & Bootstrap Configuration
# Pre-configure the only authorized owner email for one-time bootstrap and persistent access.
VIOLET_OWNER_EMAIL=avenashjojo007@gmail.com
VITE_VIOLET_OWNER_EMAIL=avenashjojo007@gmail.com
# Optional: explicitly pin owner UUID after provisioning
# VIOLET_OWNER_ID=00000000-0000-0000-0000-000000000000