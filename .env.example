# Browser-safe Supabase config.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:5173

# Supabase CLI / server helpers. Keep real values only in .env.local or managed secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Worker secrets and model settings. Never expose these through VITE_* variables.
SUPABASE_SECRET_KEY=your_supabase_secret_key
WORKER_SECRET=generate_a_long_random_value_for_scheduled_runs
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_ASSISTANT_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Optional paid fallback for raw PDF/Office files or unsupported audio formats.
OPENAI_API_KEY=your_openai_api_key
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
